{
  "name": "dormer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run content && vite",
    "content": "node scripts/build-content.ts",
    "build": "npm run content && tsc --noEmit && vite build && node scripts/seo.ts && pagefind --site dist --force-language en",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "playwright test e2e/screenshots.spec.ts && node scripts/list-shots.ts",
    "og": "node scripts/og-shots.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "pagefind": "^1.4.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.1.1",
    "yaml": "^2.8.0"
  },
  "engines": {
    "node": "24.x"
  }
}
